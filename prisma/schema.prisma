generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum RiskStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
}

enum ActionStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  invitations Invitation[]
  risks       Risk[]
  controls    Control[]
  actionPlans ActionPlan[]
  snapshots   RiskSnapshot[]
}

model Profile {
  id        String   @id
  email     String   @unique
  fullName  String?
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  orgId String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  ownedRisks       Risk[]
  ownedActionPlans ActionPlan[]

  @@unique([orgId, profileId])
}

model Invitation {
  id        String           @id @default(cuid())
  email     String
  role      MembershipRole   @default(MEMBER)
  token     String           @unique @default(cuid())
  status    InvitationStatus @default(PENDING)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime         @default(now())

  orgId String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Risk {
  id          String     @id @default(cuid())
  title       String
  description String?
  category    String?
  process     String?
  status      RiskStatus @default(OPEN)

  inherentProbability Int
  inherentImpact      Int
  residualProbability Int
  residualImpact      Int
  targetProbability   Int
  targetImpact        Int

  exposureAmount Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  ownerMembershipId String?
  ownerMembership   Membership? @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  controls    Control[]
  actionPlans ActionPlan[]
  snapshots   RiskSnapshot[]

  @@index([orgId])
}

model Control {
  id          String      @id @default(cuid())
  name        String
  description String?
  type        ControlType @default(PREVENTIVE)
  efficacy    Int         @default(3)
  createdAt   DateTime    @default(now())

  orgId String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  riskId String
  risk   Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([riskId])
}

model ActionPlan {
  id              String       @id @default(cuid())
  title           String
  status          ActionStatus @default(NOT_STARTED)
  percentComplete Int          @default(0)
  dueDate         DateTime?
  createdAt       DateTime     @default(now())

  orgId String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  riskId String
  risk   Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  ownerMembershipId String?
  ownerMembership   Membership? @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([riskId])
}

// A point-in-time snapshot of a risk's residual criticality and exposure,
// taken when an admin "closes" a quarter. Powers the Tendance trend charts.
// riskId is nullable + SetNull so deleting a risk keeps historical aggregates.
model RiskSnapshot {
  id          String   @id @default(cuid())
  period      String   // human label, e.g. "T1 2026"
  periodOrder Int      // sortable key: year * 10 + quarter
  cr          Int      // residual criticality (prob × impact) at snapshot time
  exposure    Decimal? @db.Decimal(14, 2)
  level       String   // criticality level label at snapshot time
  createdAt   DateTime @default(now())

  orgId String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  riskId String?
  risk   Risk? @relation(fields: [riskId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([riskId])
}
